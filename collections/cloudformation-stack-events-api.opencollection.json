{
  "opencollection": "1.0.0",
  "info": {
    "name": "AWS Cloud Control Change Sets Stack Events API",
    "version": "2021-09-30"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stack Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve Events for a Stack",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cloudcontrolapi.{region}.amazonaws.com/?Action=DescribeStackEvents",
            "params": [
              {
                "name": "Version",
                "value": "",
                "type": "query",
                "description": "The API version. Fixed to 2010-05-15."
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "StackName",
                  "value": ""
                },
                {
                  "name": "NextToken",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Returns all stack-related events for a specified stack in reverse chronological order."
        }
      ]
    }
  ],
  "bundled": true
}