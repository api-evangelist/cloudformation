          "http": {
            "method": "POST",
            "url": "https://cloudcontrolapi.{region}.amazonaws.com/?Action=CancelResourceRequest",
            "params": [
              {
                "name": "Version",
                "value": "",
                "type": "query",
                "description": "The API version. Fixed to 2021-09-30."
